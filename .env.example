# Скопируйте в .env и заполните. Файл .env не коммитится.
# Сгенерировать значения:
#   POSTGRES_PASSWORD:        python -c "import secrets; print(secrets.token_hex(32))"
#   SECRET_KEY:               python -c "import secrets; print(secrets.token_urlsafe(48))"
#   SECRETS_ENCRYPTION_KEYS:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Пароль БД используйте из [0-9a-f] (hex) — он подставляется в URL подключения без экранирования.

# development — локальный запуск по http://localhost:8080 (OpenAPI доступен на /api/docs);
# production — только за HTTPS reverse proxy, COOKIE_SECURE=true, https-origins.
APP_ENV=development

POSTGRES_USER=cai
POSTGRES_DB=cai
POSTGRES_PASSWORD=

SECRET_KEY=
# Несколько ключей через запятую при ротации: новый первым.
SECRETS_ENCRYPTION_KEYS=

# Origin, с которого открывается приложение (без завершающего /).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# true обязателен в production (HTTPS); false допустим только для локального http.
COOKIE_SECURE=false

# Первый Superadmin (создаётся при старте backend, только если Superadmin ещё нет).
# Пароль: не короче 12 символов, не из списка распространённых; при первом входе его потребуется сменить.
# Если в пароле есть символ $, заключите значение в одинарные кавычки.
# После инициализации удалите эти значения и установите BOOTSTRAP_ENABLED=false.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Внутренняя сеть edge (nginx ↔ backend). Меняйте, только если подсеть пересекается с сетями хоста.
# FRONTEND_EDGE_IP — адрес nginx в этой подсети; backend доверяет X-Forwarded-For только от него.
# EDGE_SUBNET=172.30.10.0/24
# FRONTEND_EDGE_IP=172.30.10.10
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# Загрузка и извлечение документов (значения по умолчанию).
# MAX_UPLOAD_MB должен быть меньше client_max_body_size в frontend/nginx.conf (30m).
MAX_UPLOAD_MB=25
MAX_PAGES=500
MAX_PENDING_EXTRACTIONS_PER_USER=10
EXTRACTION_TIMEOUT_SECONDS=180
EXTRACTION_MEMORY_MB=1024
# Таймаут LibreOffice в контейнере converter (backend ждёт ответ до 180 с, см. docs/OPERATIONS.md §10).
LIBREOFFICE_TIMEOUT_SECONDS=90

# Анализ договоров (docs/OPERATIONS.md §12): предел токенов на анализ (по оценке при запуске и по
# фактическому расходу), число одновременных анализов пользователя, лимит ответа модели, если он не
# задан в каталоге (модели с рассуждением тратят его и на рассуждение), лимит повторных запросов цитаты.
ANALYSIS_MAX_TOKENS=1500000
ANALYSIS_MAX_ACTIVE_PER_USER=3
ANALYSIS_DEFAULT_MAX_OUTPUT_TOKENS=8192
ANALYSIS_QUOTE_RETRY_LIMIT=30

# Маскировка перед облачным анализом (docs/REDACTION_PLAN.md): лимиты дочернего процесса обнаружения.
REDACTION_SCAN_TIMEOUT_SECONDS=300
REDACTION_SCAN_MEMORY_MB=2048

# Экспорт отчётов: срок хранения файла (часов) и число экспортов в очереди на пользователя.
EXPORT_TTL_HOURS=168
MAX_PENDING_EXPORTS_PER_USER=10

# ---------------------------------------------------------------- Резервное копирование
# docs/OPERATIONS.md §16. Расписание, цель, сроки хранения и режим ротации Superadmin может
# переопределить в UI («Настройки» → «Резервное копирование»); остальные параметры — только здесь.
# Применение расписания на сервере (один раз): deploy/backup-schedule.sh install
#
# Цель выгрузки за пределы сервера: none (только локальные копии), s3, local (каталог NAS/второй диск).
BACKUP_TARGET=none
# Расписание cron (5 полей) в часовом поясе BACKUP_TIMEZONE; off — только ручной запуск.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TIMEZONE=UTC
# Каталог локальных копий на сервере и их число.
BACKUP_DIR=./backups
BACKUP_KEEP_LOCAL=7
# Схема хранения во внешнем хранилище (при BACKUP_REMOTE_PRUNE=script).
BACKUP_KEEP_REMOTE_DAILY=7
BACKUP_KEEP_REMOTE_WEEKLY=4
BACKUP_KEEP_REMOTE_MONTHLY=6
# script — старые копии удаляет скрипт; lifecycle — правилами хранилища (безопаснее при взломе сервера).
# Пусто — script для local, lifecycle для s3.
BACKUP_REMOTE_PRUNE=
# Публичный ключ age получателя (age1…); обязателен для s3/local. Приватный ключ — только у администратора,
# не на сервере. Создать пару: docker run --rm contract-ai-analyzer/backup-tools:local age-keygen
BACKUP_ENCRYPTION_RECIPIENT=
# Для BACKUP_TARGET=local: абсолютный путь, отличный от BACKUP_DIR.
BACKUP_LOCAL_TARGET_DIR=
# Для BACKUP_TARGET=s3 (S3-совместимое хранилище). Ключи доступа не передаются в контейнеры приложения.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=contract-ai-analyzer
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# URL для уведомления об ошибке бэкапа (POST JSON); пусто — только лог и ненулевой код выхода.
BACKUP_NOTIFY_WEBHOOK=
# Не чаще одного бэкапа по расписанию/запросу из UI за этот интервал (защита от слишком частых запусков).
BACKUP_MIN_INTERVAL_MINUTES=60
# Необязательно: сеть Docker для контейнеров выгрузки и уведомления, если хранилище — контейнер в этой сети.
BACKUP_DOCKER_NETWORK=
